<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension id="application" point="org.eclipse.core.runtime.applications">
      <application>
         <run class="jext.eclipse.shapeeditor.ShapeEditorApplication"/>
      </application>
   </extension>

   <extension id="product" point="org.eclipse.core.runtime.products">
      <product application="jext.eclipse.shapeeditor.application" name="Shape Editor"/>
   </extension>

   <extension point="org.eclipse.ui.perspectives">
      <perspective
            id="jext.eclipse.shapeeditor.perspective"
            name="Shape Editor"
            class="jext.eclipse.shapeeditor.ShapeEditorPerspective"/>
   </extension>

   <extension point="org.eclipse.ui.views">
      <view
            id="jext.eclipse.shapeeditor.views.directoryTree"
            name="Directories"
            class="jext.eclipse.shapeeditor.views.DirectoryTreeView"
            restorable="true"/>
   </extension>

   <extension point="org.eclipse.ui.editors">
      <editor
            class="jext.eclipse.shapeeditor.editors.shp.ShapeFileEditor"
            default="false"
            extensions="shp"
            id="jext.eclipse.shapeeditor.editor"
            name="Shape File Viewer"/>
      <editor
            class="jext.eclipse.shapeeditor.editors.xml.XmlFileEditor"
            default="false"
            extensions="xml"
            id="jext.eclipse.shapeeditor.editors.xml.XmlFileEditor"
            name="XML File Viewer"/>
      <editor
            class="jext.eclipse.shapeeditor.editors.dbf.DbfFileEditor"
            default="false"
            extensions="dbf"
            id="jext.eclipse.shapeeditor.editors.dbf.DbfFileEditor"
            name="DBF File Viewer"/>
      <editor
            class="jext.eclipse.shapeeditor.editors.csv.CsvFileEditor"
            default="false"
            extensions="csv"
            id="jext.eclipse.shapeeditor.editors.csv.CsvFileEditor"
            name="CSV File Viewer"/>
   </extension>

</plugin>

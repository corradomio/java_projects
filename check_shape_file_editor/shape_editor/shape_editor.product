<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>
<product name="Shape Editor"
         uid="jext.eclipse.shapeeditor.product"
         id="jext.eclipse.shapeeditor.product"
         application="jext.eclipse.shapeeditor.application"
         useFeatures="false"
         includeLaunchers="true">
   <plugins>
      <plugin id="jext.eclipse.shapeeditor"/>
      <plugin id="org.eclipse.core.runtime"/>
      <plugin id="org.eclipse.draw2d"/>
      <plugin id="org.eclipse.equinox.app"/>
      <plugin id="org.eclipse.jface"/>
      <plugin id="org.eclipse.osgi"/>
      <plugin id="org.eclipse.swt"/>
      <plugin id="org.eclipse.ui"/>
      <property name="osgi.logfile" value="../logs/equinox.log" />
      <property name="log4j2.configurationFile" value="./logsconfig/log4j2.xml" />
      <property name="log4j.configuration" value="file:./logsconfig/log4j.xml" />
      <property name="logback.configurationFile" value="./logsconfig/logback.xml" />
      <property name="java.util.logging.config.file" value="./logsconfig/jul.properties" />
   </plugins>
</product>

        <plugin id="org.osgi.service.upnp"/>
        <plugin id="org.osgi.service.useradmin"/>
        <plugin id="org.osgi.service.wireadmin"/>
        <plugin id="org.osgi.util.function"/>
        <plugin id="org.osgi.util.measurement"/>
        <plugin id="org.osgi.util.position"/>
        <plugin id="org.osgi.util.promise"/>
        <plugin id="org.osgi.util.xml"/>
        <plugin id="slf4j.api"/>
        <plugin id="rcp.ide"/>
        <plugin id="jakarta.annotation-api" version="1.3.5"/>
        <plugin id="jakarta.annotation-api" version="2.1.1"/>
        <plugin id="jakarta.inject.jakarta.inject-api" version="1.0.5"/>
        <plugin id="jakarta.inject.jakarta.inject-api" version="2.0.1"/>
    </plugins>
    <configurations>
        <plugin id="org.eclipse.core.runtime" autoStart="true" startLevel="4"/>
        <plugin id="org.eclipse.equinox.common" autoStart="true" startLevel="2"/>
        <plugin id="org.eclipse.equinox.event" autoStart="true" startLevel="2"/>
        <plugin id="org.apache.felix.scr" autoStart="true" startLevel="2"/>
        <property name="osgi.bundles.defaultStartLevel" value="4"/>
        <property name="osgi.logfile" value="./logs/equinox.log"/>
        <property name="log4j2.configurationFile" value="./logsconfig/log4j2.xml"/>
        <property name="log4j.configuration" value="file:./logsconfig/log4j.xml"/>
        <property name="logback.configurationFile" value="./logsconfig/logback.xml"/>
        <property name="java.util.logging.config.file" value="./logsconfig/jul.properties"/>
    </configurations>
</product>

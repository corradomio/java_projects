<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>
<product name="RCP File Explorer" uid="rcp.ide" id="rcp.ide.product" application="rcp.ide.application"
         version="1.0.0.qualifier" useFeatures="false" includeLaunchers="true">
    <configIni use="default"/>
    <launcherArgs>
        <vmArgs>-Xms128m -Xmx1024m</vmArgs>
        <vmArgsMac>-XstartOnFirstThread</vmArgsMac>
    </launcherArgs>
    <windowImages/>
    <launcher name="rcp-ide">
        <win useIco="false">
            <bmp/>
        </win>
    </launcher>
    <vm>
        <windows include="false"/>
    </vm>
    <plugins>
        <plugin id="com.ibm.icu"/>
        <plugin id="com.sun.jna"/>
        <plugin id="com.sun.jna.platform"/>
        <plugin id="org.apache.batik.constants"/>

    <build>
        <plugins>
            <!-- 1. Use Apache Felix maven-bundle-plugin to generate manifests -->
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>5.1.9</version>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <!-- Identifies the class that starts/stops this bundle -->
                        <Bundle-Activator>org.example.Activator</Bundle-Activator>
                        <!-- Packages you want to expose to other bundles -->
                        <Export-Package>org.example</Export-Package>
                        <!-- Automatically calculates imports based on bytecode -->
                        <Import-Package>*</Import-Package>
                    </instructions>
                </configuration>
                <executions>
                    <execution>
                        <id>bundle-manifest</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>manifest</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Standard JAR plugin configured to pick up the generated manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>

<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                pattern="######## LOG4J XML LOADED ######## [%level] %msg%n"/>
        </Console>

    </appenders>

    <loggers>

        <root level="debug">
            <appender-ref ref="Console"/>
        </root>

    </loggers>

</configuration>